<script>
window.ZhiMoI18n = <%- serializeForInlineScript(clientI18n) %>;
</script>
<script type="module" src="<%= versioned_asset('js/main.js') %>"></script>
<% if (obsidian_callout_enabled()) { %>
<script type="module" src="<%= versioned_asset('js/obsidian-callout.js') %>"></script>
<% } %>
<% if (is_post() && photoswipe_enabled()) { %>
<script type="module" src="<%= versioned_asset('js/photoswipe.js') %>"></script>
<% } %>

<% if (theme.search && theme.search.enable) { %>
<%
const currentLang = page_lang(page);
const searchLanguages = configured_languages();
const searchLanguageRoots = Object.fromEntries(
  searchLanguages.map(lang => [lang, url_for(localized_path('/', lang))])
);
const searchConfig = {
  path: url_for(theme.search.path || 'search.json'),
  currentLang,
  defaultLang: searchLanguages[0] || currentLang,
  languages: searchLanguages,
  languageRoots: searchLanguageRoots,
  placeholder: __('search.placeholder'),
  noResults: __('search.no_results'),
  fallbackHint: __('search.fallback_hint'),
  resultsCount: __('search.results_count'),
  showAll: __('search.show_all'),
  showLess: __('search.show_less'),
  loadError: __('search.load_error'),
  closeLabel: __('accessibility.close_search')
};
%>
<script>
window.ZhiMoSearch = <%- serializeForInlineScript(searchConfig) %>;
</script>
<script type="module" src="<%= versioned_asset('js/search.js') %>"></script>
<% } %>

<% if (is_post() && theme.highlight && theme.highlight.copy_button) { %>
<script type="module" src="<%= versioned_asset('js/highlight.js') %>"></script>
<% } %>
