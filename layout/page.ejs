<% const pageClass = page.type ? `page-content page-content-${page.type}` : 'page-content'; %>

<div class="<%= pageClass %>">
  <article class="page-article reveal-item">
    <header class="page-header">
      <h1 class="page-title"><%= page.title %></h1>
    </header>
    <div class="page-body">
      <%- page.content %>
    </div>
  </article>
</div>
